# Copy to .env.local and fill in the values. Never commit real secrets.
# On Vercel, set these under Settings → Environment Variables (or `vercel env pull`).

# --- App URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_URL=

# --- Neon Postgres ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: email confirmation redirect during local sign-up
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Image uploads (ImgBB) ---
# IMGBB_API_KEY (server-only) is preferred; NEXT_PUBLIC_IMGBB_API_KEY is the fallback.
IMGBB_API_KEY=
NEXT_PUBLIC_IMGBB_API_KEY=

# --- Dodo Payments ---
# "test_mode" or "live_mode". Defaults to live_mode in production, test_mode otherwise.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
NEXT_PUBLIC_DODO_PRO_PRODUCT_ID=
NEXT_PUBLIC_DODO_PRO_YEARLY_PRODUCT_ID=
NEXT_PUBLIC_DODO_LIFETIME_PRODUCT_ID=

# --- Cron ---
# Bearer token required by /api/cron/invoicing
CRON_SECRET=

# --- PDF rendering (optional) ---
# Local Chrome/Chromium path if the bundled browser isn't found
PUPPETEER_EXECUTABLE_PATH=

# --- Scripts (optional) ---
# Demo account used by scripts/seed-demo.mjs
LOGIN_EMAIL=
LOGIN_PASSWORD=

# --- Vercel (set automatically by `vercel env pull`) ---
VERCEL_OIDC_TOKEN=
